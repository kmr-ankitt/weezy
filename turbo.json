{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["REDIS_HOST", "REDIS_PORT", "DATABASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["PORT", "REDIS_HOST", "REDIS_PORT", "DATABASE_URL"] 
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["PORT", "REDIS_HOST", "REDIS_PORT"] 
    }
  }
}
